# Application
APP_NAME=fraud-detector
LOG_LEVEL=INFO

# Model & Features
MODEL_PATH=training/models/model.joblib
FEATURE_ORDER_PATH=training/models/feature_order.txt

# Redis / Caching
CACHE_BACKEND=auto
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

# Docker compose overrides
DOCKER_REDIS_URL=redis://redis:6379/0
